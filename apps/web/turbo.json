{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "CRON_SECRET",
        "NEON_REALTIME_URL",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN"
      ]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": [
        "CRON_SECRET",
        "NEON_REALTIME_URL",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN"
      ]
    }
  }
}
