{
  "name": "@motormetrics/web",
  "description": "Web application for MotorMetrics",
  "version": "5.25.0",
  "type": "module",
  "author": "Ru Chern Chong <ruchern.chong@motormetrics.app>",
  "license": "MIT",
  "scripts": {
    "dev": "portless motormetrics next dev",
    "build": "next build",
    "lint": "biome check",
    "format": "biome format --write src",
    "start": "next start",
    "analyse": "next experimental-analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps --only-shell chromium",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "auth:generate": "pnpm dlx auth@rc generate --config ./src/lib/auth.ts --output ../../packages/database/src/schema/auth.ts --yes",
    "vercel-build": "turbo run @motormetrics/database#migrate && pnpm build",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "predev": "node ./scripts/copy-maplibre-worker.mjs"
  },
